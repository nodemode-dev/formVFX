#!/usr/bin/env bash
set -e
export FORMVFX_CALLER_DIR="${FORMVFX_CALLER_DIR:-$PWD}"
cd "$(dirname "$0")"
usage() {
  printf 'formvfx %s · motion graphics and visual effects\n' "$(sed -n "s/^export const VERSION = '\(.*\)';$/\1/p" frontend/src/version.ts 2>/dev/null)"
  cat << 'EOF'

usage: ./formvfx [command] [options]

  (none) | boot         boot the engine (8250) and the interface (5250) together
  install [--dev]       install the engine service, build the compositing engine and install the interface
  install-native [--dev]          rebuild the compositing engine (native/fvx-core) into the engine's venv
  install-desktop       install PyInstaller and check the Rust and Tauri toolchain
  backend               boot the engine only
  frontend              boot the interface only
  build                 production build of the interface into frontend/dist
  serve                 serve the built interface from the engine on 127.0.0.1:8250 (FORMVFX_PORT changes the port)
                        headless agents: FORMVFX_AGENTS=allow ./formvfx serve lets outside agents edit with no window open
                        (ask is the default and needs a window to answer; deny refuses outside agents)
  freeze                freeze the engine service and the compositing engine into the Tauri sidecar binary
  desktop dev|build     run the desktop app, or build and install it (build is the same as ./build_app)
  doctor                check the toolchain, installs and ports

  exec ID [JSON]        run one formvfx command in the running app (prints the JSON result)
  batch JSON|FILE       run several commands as one undo step
  commands [FILTER]     list the commands (id, label, params)
  describe ID           one command with its JSON Schema
  state                 the open project, active comp, selection and time
  frame OUT.png [--time S] [--comp C] [--max N]  save a rendered frame
  render [--wait|--status|--stop]  render the Render Queue in the background; --wait polls until it is done
  extensions            the Form extensions the app loads (id, version, source, state, commands)
  extension ID COMMAND [JSON]  run a command an extension contributes, in the open window

  claude [ARGS]         start Claude Code here, connected to formvfx over MCP (starts the engine when needed)
  mcp                   formvfx over MCP's stdio transport (starts the engine when needed)
  agents install|sync|status  set Claude Code, Codex and Cursor up (install), refresh the skills (sync)
  counts [--check]      code sizes for the README
  presets [--check]     rebuild presets/text-animators.json from setup/text_presets.py
  clean [--all]         remove build output (--all also venv and node_modules)
  help                  this text
EOF
}
cmd="${1:-boot}"
[ $# -gt 0 ] && shift
case "$cmd" in
  boot|dev) exec setup/boot_all "$@" ;;
  install) exec setup/install_all "$@" ;;
  install-native) exec setup/build_native "$@" ;;
  install-desktop) exec setup/install_desktop "$@" ;;
  backend) exec setup/boot_backend "$@" ;;
  frontend) exec setup/boot_frontend "$@" ;;
  build) exec setup/build_frontend "$@" ;;
  serve) exec setup/serve "$@" ;;
  freeze) exec setup/freeze_backend "$@" ;;
  desktop)
    sub="${1:-dev}"
    [ $# -gt 0 ] && shift
    case "$sub" in
      dev) exec setup/desktop_dev "$@" ;;
      build) exec ./build_app "$@" ;;
      *) usage; exit 2 ;;
    esac ;;
  doctor) exec setup/doctor "$@" ;;
  exec|batch|commands|describe|state|frame|render|extensions|extension) exec python3 setup/fx.py "$cmd" "$@" ;;
  claude)
    command -v claude >/dev/null 2>&1 || { printf '[formvfx] Claude Code is not installed: https://claude.com/claude-code\n'; exit 1; }
    exec claude --mcp-config "{\"mcpServers\":{\"formvfx\":{\"type\":\"stdio\",\"command\":\"$PWD/formvfx\",\"args\":[\"mcp\"]}}}" --allowedTools mcp__formvfx "$@" ;;
  mcp) exec python3 setup/mcp_stdio.py "$@" ;;
  agents) exec python3 setup/agents.py "$@" ;;
  counts) exec python3 setup/line_counts.py "$@" ;;
  presets) exec python3 setup/text_presets.py "$@" ;;
  clean) exec setup/clean "$@" ;;
  help|-h|--help) usage ;;
  *) printf '[formvfx] unknown command: %s\n\n' "$cmd"; usage; exit 2 ;;
esac
