#!/usr/bin/env bash
set -e
source "$(dirname "$0")/lib.sh"
fx_venv
command -v cargo >/dev/null 2>&1 || fx_die "Rust is required for the compositing engine: $FX_RUST_GET"
profile=(--release)
for arg in "$@"; do
  case "$arg" in
    --dev) profile=() ;;
  esac
done
python -c "import maturin" 2>/dev/null || pip install "maturin>=1.15,<2"
cd "$FORMVFX_ROOT/native/fvx-core"
maturin develop "${profile[@]}"
python -c "import json, fvx_core; c = json.loads(fvx_core.Engine().capabilities()); print('[formvfx] engine', fvx_core.__version__, 'ready:', c['commands'], 'commands,', c['effects']['total'], 'effects')"
