#!/usr/bin/env bash
set -e
source "$(dirname "$0")/lib.sh"
fx_venv
cd "$FORMVFX_ROOT/backend"
if [ "$(fx_os)" = macos ]; then pip install -r requirements_desktop_macos.txt; else pip install -r requirements_desktop.txt; fi
if ! command -v cargo >/dev/null 2>&1; then
  fx_say "Rust is not installed. Install it from https://rustup.rs then rerun ./formvfx install-desktop"
  exit 1
fi
if [ "$(fx_os)" = linux ] && ! pkg-config --exists webkit2gtk-4.1 2>/dev/null; then
  fx_say "Tauri needs system libraries. On Debian or Ubuntu run:"
  fx_say "sudo apt install libwebkit2gtk-4.1-dev build-essential curl wget file libxdo-dev libssl-dev libayatana-appindicator3-dev librsvg2-dev patchelf"
  exit 1
fi
[ -x "$FORMVFX_ROOT/frontend/node_modules/.bin/tauri" ] || ( cd "$FORMVFX_ROOT/frontend" && npm install )
fx_say "desktop toolchain ready: rustc $(rustc --version | awk '{print $2}')"
