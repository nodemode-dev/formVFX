{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "formvfx",
  "version": "0.25.0",
  "identifier": "ai.nodemode.formvfx",
  "build": {
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "splash",
        "title": "formvfx",
        "url": "splash.html",
        "width": 360,
        "height": 180,
        "resizable": false,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Video",
    "shortDescription": "Motion graphics and visual effects",
    "longDescription": "formvfx is a motion graphics and visual effects compositor: compositions, layers, keyframes, effects, text and shape animation, masks, 3D cameras and lights, tracking, expressions and a render queue, with an agent terminal that drives every tool.",
    "copyright": "Copyright 2026 nodemode-ai.",
    "externalBin": ["binaries/formvfx-engine"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist"
    },
    "fileAssociations": [
      { "ext": ["fvxproj"], "name": "formvfx Project", "description": "formvfx motion graphics project", "role": "Editor", "mimeType": "application/x-formvfx" },
      { "ext": ["ecproj"], "name": "formvfx Project (earlier releases)", "description": "formvfx project from an earlier release, opened as an import", "role": "Viewer", "mimeType": "application/x-formvfx-legacy" }
    ],
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": ["https://github.com/nodemode-ai/formvfx/releases/latest/download/latest.json"]
    }
  }
}
