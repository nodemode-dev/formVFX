{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FormVFX",
  "version": "0.52.6",
  "identifier": "ai.nodemode.formvfx",
  "build": {
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "splash",
        "title": "FormVFX",
        "url": "splash.html",
        "width": 360,
        "height": 200,
        "resizable": false,
        "decorations": false,
        "center": true,
        "transparent": true,
        "shadow": false,
        "visible": false
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Video",
    "shortDescription": "Motion graphics and visual effects",
    "longDescription": "FormVFX is a motion graphics and visual effects compositor: compositions, layers, keyframes, effects, text and shape animation, masks, 3D cameras and lights, tracking, expressions and a render queue, with an agent terminal that drives every tool.",
    "copyright": "Copyright 2026 nodemode-ai.",
    "externalBin": ["binaries/formvfx-engine"],
    "resources": {
      "../LICENSE": "LICENSE",
      "../NOTICE.md": "NOTICE.md"
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "linux": {
      "deb": {
        "recommends": ["gstreamer1.0-plugins-base", "gstreamer1.0-plugins-good", "gstreamer1.0-libav"]
      },
      "rpm": {
        "recommends": ["gstreamer1-plugins-base", "gstreamer1-plugins-good"]
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist"
    },
    "fileAssociations": [
      { "ext": ["fvxproj"], "name": "formvfx Project", "description": "formvfx motion graphics project", "role": "Editor", "mimeType": "application/x-formvfx" },
      { "ext": ["ecproj"], "name": "formvfx Project (earlier releases)", "description": "formvfx project from an earlier release, opened as an import", "role": "Viewer", "mimeType": "application/x-formvfx-legacy" }
    ],
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": ["https://github.com/nodemode-ai/formcompiler/releases/download/formvfx-updates/latest.json"]
    }
  }
}
